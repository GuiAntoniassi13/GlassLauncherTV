<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#1B1145" android:centerColor="#3A2A8F" android:endColor="#06474A" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:left="40dp" android:top="50dp" android:right="40dp" android:bottom="50dp">
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <solid android:color="#33FFFFFF" />
            <stroke android:width="2dp" android:color="#88FFFFFF" />
        </shape>
    </item>
</layer-list>
